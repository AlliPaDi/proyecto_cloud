{
  "network_topology": {
    "description": "Topología SDN con 3 servidores, segmentación VlanSlice y dominios de VLAN multicapa",
    "nodes": {
      "switches": [
        {"id": "OFS"}
      ],
      "bridges": [
        {"id": "Br-W1", "type": "OVS Worker", "server": 1},
        {"id": "Br-Slice1", "type": "OVS Slice", "server": 1},
        {"id": "Br-W2", "type": "OVS Worker", "server": 2},
        {"id": "Br-Slice2", "type": "OVS Slice", "server": 2},
        {"id": "Br-W3", "type": "OVS Worker", "server": 3},
        {"id": "Br-Slice3", "type": "OVS Slice", "server": 3}
      ],
      "virtual_machines": [
        {"id": "VM1", "server": 1},
        {"id": "VM2", "server": 2},
        {"id": "VM3", "server": 3},
        {"id": "VM4", "server": 1},
        {"id": "VM5", "server": 2},
        {"id": "VM6", "server": 3}
      ]
    },
    "physical_topology": {
      "ofs_to_workers": [
        {"from": "OFS", "to": "Br-W1"},
        {"from": "OFS", "to": "Br-W2"},
        {"from": "OFS", "to": "Br-W3"}
      ],
      "workers_to_slices": [
        {"from": "Br-W1", "to": "Br-Slice1", "link_type": "VlanSlice"},
        {"from": "Br-W2", "to": "Br-Slice2", "link_type": "VlanSlice"},
        {"from": "Br-W3", "to": "Br-Slice3", "link_type": "VlanSlice"}
      ]
    },
    "logical_topology": {
      "description": "Conexiones lógicas de las VMs a través de los Bridges Slice y conexiones directas entre VMs",
      "vm_to_slice_connections": [
        {"vm": "VM1", "connected_to": "Br-Slice1", "vlan": 200},
        {"vm": "VM2", "connected_to": "Br-Slice2", "vlan": 200},
        {"vm": "VM2", "connected_to": "Br-Slice2", "vlan": 300},
        {"vm": "VM3", "connected_to": "Br-Slice3", "vlan": 100},
        {"vm": "VM3", "connected_to": "Br-Slice3", "vlan": 300},
        {"vm": "VM4", "connected_to": "Br-Slice1", "vlan": 100},
        {"vm": "VM4", "connected_to": "Br-Slice1", "vlan": 400},
        {"vm": "VM5", "connected_to": "Br-Slice2", "vlan": 400},
        {"vm": "VM5", "connected_to": "Br-Slice2", "vlan": 500},
        {"vm": "VM6", "connected_to": "Br-Slice3", "vlan": 500}
      ],
      "vm_to_vm_direct_connections": [
        {"from": "VM1", "to": "VM4", "vlan": 0, "note": "Default/Untagged"}
      ],
      "vlan_domains_summary": {
        "VLAN_0": ["VM1", "VM4"],
        "VLAN_100": ["VM3", "VM4"],
        "VLAN_200": ["VM1", "VM2"],
        "VLAN_300": ["VM2", "VM3"],
        "VLAN_400": ["VM4", "VM5"],
        "VLAN_500": ["VM5", "VM6"]
      }
    }
  }
}